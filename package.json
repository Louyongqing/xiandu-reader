{
  "name": "xiandu-reader",
  "private": true,
  "version": "0.1.0",
  "description": "闲读 · 一个安静的本地桌面小说阅读器，使用 Tauri、React 和 TypeScript 构建。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Louyongqing/xiandu-reader.git"
  },
  "homepage": "https://github.com/Louyongqing/xiandu-reader#readme",
  "bugs": {
    "url": "https://github.com/Louyongqing/xiandu-reader/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "notices": "node scripts/generate-notices.mjs",
    "tauri": "tauri",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "0.4.6",
    "@tauri-apps/api": "~2.10.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
