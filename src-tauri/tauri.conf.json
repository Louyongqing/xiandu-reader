{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "闲读",
  "version": "0.1.0",
  "identifier": "com.xiandu.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "闲读",
        "width": 420,
        "height": 780,
        "minWidth": 340,
        "minHeight": 560,
        "maxWidth": 680,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "backgroundColor": "#F7F9F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "给自己一页空闲",
    "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false } }
  }
}
